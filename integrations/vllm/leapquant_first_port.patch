+# SPDX-License-Identifier: Apache-2.0
+"""LeapQuant decode for Qwen GDN layers (VLLM_GDN_LEAPQUANT=1), first port.
+
+The arithmetic and the glue live in the leapquant-core repository
+(kernel/leapquant_engine.py, class BlockEngineState, tested there on a CPU
+against its C++ reference). This module locates that repository, checks the
+configuration and builds one state object per GDN layer.
+
+Scope of the first port
+  - mamba cache mode "none" (prefix caching off): a request keeps one state
+    block for its whole life. In "align" mode vLLM moves the state between
+    blocks inside its own kernels, which this port does not follow.
+  - no speculative decoding.
+  - --mamba-ssm-cache-dtype float32.
+
+Environment
+  VLLM_GDN_LEAPQUANT=1        switch
+  LEAPQUANT_HOME              leapquant-core checkout, built with `make cuda`
+  VLLM_GDN_LEAPQUANT_SLOTS    LeapQuant slots per layer (default: max_num_seqs
+                              plus a quarter, at least 16 spare). Each slot is
+                              about 0.9 MB per layer for 32 heads of 128 x 128.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from typing import Any
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# Working memory of the kernel, shared by all layers (they run one after another).
+_SHARED_SCRATCH: dict[tuple, torch.Tensor] = {}
+
+
+def _load_engine_module():
+    home = os.environ.get("LEAPQUANT_HOME")
+    if not home:
+        raise RuntimeError(
+            "VLLM_GDN_LEAPQUANT=1 requires LEAPQUANT_HOME: the path of a "
+            "leapquant-core checkout in which `make cuda` has been run."
+        )
+    kernel_dir = os.path.join(home, "kernel")
+    if not os.path.isfile(os.path.join(kernel_dir, "leapquant_engine.py")):
+        raise RuntimeError(f"LEAPQUANT_HOME={home!r} holds no kernel/leapquant_engine.py")
+    if kernel_dir not in sys.path:
+        sys.path.insert(0, kernel_dir)
+    os.environ.setdefault("LEAPQUANT_BUILD_DIR", os.path.join(home, "build"))
+    import leapquant_engine
+
+    return leapquant_engine
+
+
+def check_leapquant_config(vllm_config: Any, packed_decode_enabled: bool) -> None:
+    """Fail at start-up, with a reason, in every configuration the first port
+    does not cover."""
+    mode = vllm_config.cache_config.mamba_cache_mode
+    if mode != "none":
+        raise ValueError(
+            "VLLM_GDN_LEAPQUANT supports mamba cache mode 'none' only (prefix "
+            f"caching off); got {mode!r}."
+        )
+    if vllm_config.speculative_config is not None:
+        raise ValueError("VLLM_GDN_LEAPQUANT does not support speculative decoding.")
+    if not packed_decode_enabled:
+        raise ValueError(
+            "VLLM_GDN_LEAPQUANT requires VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE (the default)."
+        )
+    _load_engine_module()
+
+
+def build_leapquant_state(ssm_state: torch.Tensor, vllm_config: Any):
+    """One BlockEngineState for one GDN layer, over its state view
+    ``ssm_state`` = [num_blocks, HV, V, K]."""
+    if ssm_state.dtype != torch.float32:
+        raise ValueError(
+            "VLLM_GDN_LEAPQUANT requires --mamba-ssm-cache-dtype float32; the "
+            f"recurrent state is {ssm_state.dtype}."
+        )
+    blocks, value_heads, value_channels, key_channels = ssm_state.shape
+    max_num_seqs = vllm_config.scheduler_config.max_num_seqs
+    slots = int(
+        os.environ.get(
+            "VLLM_GDN_LEAPQUANT_SLOTS", max_num_seqs + max(16, max_num_seqs // 4)
+        )
+    )
+    key = (str(ssm_state.device), max_num_seqs, value_heads, value_channels, key_channels)
+    scratch = _SHARED_SCRATCH.get(key)
+    if scratch is None:
+        scratch = torch.empty(
+            (max_num_seqs, value_heads, value_channels, key_channels),
+            dtype=torch.float32,
+            device=ssm_state.device,
+        )
+        _SHARED_SCRATCH[key] = scratch
+    state = _load_engine_module().BlockEngineState(
+        layers=1,
+        blocks=blocks,
+        value_heads=value_heads,
+        key_channels=key_channels,
+        value_channels=value_channels,
+        lq_slots=slots + 1,
+        max_rows=max_num_seqs,
+        device=ssm_state.device,
+        idle_steps=2,
+        scratch=scratch,
+    )
+    logger.info_once(
+        "LeapQuant GDN decode: %d slots per layer over %d state blocks",
+        slots,
+        blocks,
+    )
+    return state
