+    def _leapquant_align_flush(
+        self,
+        force_flush: torch.Tensor,
+        write_pos: torch.Tensor,
+        cache_len: int,
+        seq_lens_cpu: Optional[torch.Tensor] = None,
+        slots: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        """LeapQuant: when ANY request of the batch closes its window on this step,
+        close every request's window (int32 flags, on device, no host sync).
+
+        A LeapQuant fold is a long chain of small steps per head. With unaligned
+        cursors some request folds on almost every step, and every layer of every
+        step waits for one such chain: measured on an H100 at about 0.2 ms per
+        layer, 5 ms per decode step, at any batch size. Aligned, the requests that
+        run together fold together once per window and the other steps fold
+        nothing. A request that joins later is pulled into step at the next fold;
+        a forced flush of a partly filled window is what the radix track boundary
+        already asks of the kernel."""
+        if not get_exec().mamba.enable_linear_leapquant:
+            return force_flush
+        # LEAPQUANT_ALIGN_FOLDS=0: every request folds on its own step. With the fast
+        # (Triton) fold a fold of a few rows costs about 30 us per layer, so spreading
+        # the folds over the 16 steps of a window removes the aligned fold step (the
+        # p99 spike) at about the same total work.
+        import os
+
+        # LEAPQUANT_TRACK_FLUSH=0 (backlog B55): drop the radix track-boundary flushes, radix
+        # cache on or off. ReplaySSM (so LeapQuant) runs only with the no_buffer strategy, and
+        # there nothing reads a decode state at a track boundary: a running request is published
+        # after a prefill chunk (empty window), a finished one up to its last fold (settle_replay
+        # takes the cursor off the cached length). Each flush was a fold of a partly filled window
+        # that put the request out of phase with the aligned folds. Kept with extra_buffer.
+        if os.environ.get("LEAPQUANT_TRACK_FLUSH", "").strip() == "0" and not getattr(
+            get_exec().mamba, "enable_mamba_extra_buffer", False
+        ):
+            force_flush = torch.zeros_like(force_flush)
+
+        # LEAPQUANT_FOLD_POLICY=auto (14 Nov 2026): with the radix cache off nothing reads a
+        # snapshot, so the track-boundary flushes are dropped (for LeapQuant each was a
+        # single-request fold that put the request out of phase, and aligned folds then pulled
+        # every request into an early fold); with the radix cache on, every request folds on
+        # its own step (measured 2-3% faster than aligned folds there).
+        if os.environ.get("LEAPQUANT_FOLD_POLICY", "").strip() == "auto":
+            if not get_memory().disable_radix_cache:
+                return force_flush
+            force_flush = torch.zeros_like(force_flush)
+        # LEAPQUANT_FOLD_POLICY=stagger (backlog B53): each request folds on its own phase,
+        # (seq_len + slot) % cache_len == 0, so ~1/cache_len of the requests fold on every
+        # step and there is no aligned fold step; no alignment below.
+        if (
+            os.environ.get("LEAPQUANT_FOLD_POLICY", "").strip() == "stagger"
+            and seq_lens_cpu is not None
+            and slots is not None
+        ):
+            rows = force_flush.shape[0]
+            lengths = seq_lens_cpu[:rows].to(torch.int64)
+            if lengths.shape[0] < rows:
+                lengths = torch.cat(
+                    [lengths, torch.zeros((rows - lengths.shape[0],), dtype=torch.int64)]
+                )
+            lengths = lengths.to(device=force_flush.device)
+            phase = (lengths + slots[:rows].to(torch.int64).clamp(min=0)) % cache_len == 0
+            if get_memory().disable_radix_cache:
+                force_flush = torch.zeros_like(force_flush)
+            return force_flush | phase.to(force_flush.dtype)
+        if os.environ.get("LEAPQUANT_ALIGN_FOLDS", "1").strip() == "0":
+            return force_flush
+        # Only a window that is FULL pulls the others along. A radix-track flush
+        # of one row must not: with many rows, some row is at a track boundary
+        # on almost every step, and every request would then fold on almost
+        # every step (measured: throughput at 128 requests fell by a third).
+        any_full = (write_pos == cache_len - 1).any()
+        return force_flush | any_full.to(force_flush.dtype)
