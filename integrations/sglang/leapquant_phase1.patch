new file mode 100644
index 0000000000..5d5cccee80
--- /dev/null
+++ b/python/sglang/srt/layers/attention/linear/leapquant_state.py
@@ -0,0 +1,223 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LeapQuant decode for GDN linear attention (--enable-linear-leapquant).
+
+The arithmetic and the engine-side glue live in the leapquant-core repository
+(kernel/leapquant_engine.py, kernel/leapquant_triton.py; tested there against its
+C++ reference). This module locates that repository, builds one ``EngineState``
+over the MambaPool, and registers it as a slot-indexed side state so that it
+hears about every slot that is cleared or copied.
+
+How the state is kept: environment variable LEAPQUANT_STATE
+
+``mirror`` (default; integration phase 1)
+    ``temporal`` (the fp32 state) is kept as it is. A slot that starts to decode
+    is adopted from ``temporal[slot]``; at every fold the full-precision state is
+    written back to ``temporal[slot]``. That is the contract ReplaySSM already
+    gives the radix cache, so no cache code changes. No memory is saved.
+
+``compressed`` (phase 2)
+    ``temporal`` has two rows only. The prefill of a layer runs on a staging
+    tensor with one row per request of the batch, and at its end the states are
+    compressed into the LeapQuant pool; a later chunk of a chunked prefill starts
+    from its own state, decompressed. Decode reads and writes only the pool. A slot
+    costs the LeapQuant state (about 21 MB for Qwen3.5-9B) instead of the fp32 state
+    (50 MB), and the memory accounting charges the former
+    (configs/mamba_utils.py). The radix cache works on it: a cached prefix is a
+    slot's state at its last fold, which is the boundary state, and the slot
+    copies of MambaPool.copy_from reach EngineState.copy_slots. Not supported with
+    it: --enable-int8-mamba-checkpoint, --enable-hierarchical-cache.
+
+LEAPQUANT_FAST=0 selects the exact CUDA kernels instead of the fast Triton ones
+(mirror only).
+
+LEAPQUANT_COMPENSATORS sets the compensators per head: "4" (default, the paper's
+setting) or a default followed by "from_layer:count" items, e.g. "4,20:8" for 8
+compensators on the model's layers 20 and above (where 4 lose more than bf16 does). With --enable-int8-mamba-checkpoint (mirror only) the radix
+cache's checkpoints are kept in the LeapQuant boundary format
+(``leapquant_checkpoint_store_class``).
+
+Either way the ReplaySSM decode ring is not used, so it is allocated for one slot.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import sys
+from typing import Any, Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+# The MambaPool reserves slot 0 for padded batch rows.
+_PADDING_SLOT = 0
+# Compensators per head (the paper's setting); see leapquant_compensators().
+LEAPQUANT_COMPENSATORS = 4
+
+
+def leapquant_compensators(layer_id: int) -> int:
+    """Compensators for a model layer, from LEAPQUANT_COMPENSATORS ("4" or e.g. "4,20:8")."""
+    spec = os.environ.get("LEAPQUANT_COMPENSATORS", str(LEAPQUANT_COMPENSATORS)).replace(" ", "")
+    items = [item for item in spec.split(",") if item]
+    try:
+        count = int(items[0])
+        rules = [tuple(int(part) for part in item.split(":")) for item in items[1:]]
+        if any(len(rule) != 2 for rule in rules):
+            raise ValueError("an item is not from_layer:count")
+    except (ValueError, IndexError) as error:
+        raise ValueError(f"LEAPQUANT_COMPENSATORS={spec!r}: expected e.g. '4' or '4,20:8'") from error
+    for value in [count] + [rule[1] for rule in rules]:
+        if not 1 <= value <= 16:
+            raise ValueError(f"LEAPQUANT_COMPENSATORS={spec!r}: {value} compensators (1 to 16 are supported)")
+    for first_layer, layer_count in rules:
+        if layer_id >= first_layer:
+            count = layer_count
+    return count
+
+
+def leapquant_enabled() -> bool:
+    try:
+        from sglang.srt.runtime_context import get_exec
+
+        return bool(get_exec().mamba.enable_linear_leapquant)
+    except Exception:  # noqa: BLE001 - no server config (tools, unit tests)
+        return False
+
+
+def leapquant_state_mode() -> str:
+    mode = os.environ.get("LEAPQUANT_STATE", "mirror").strip().lower()
+    if mode not in ("mirror", "compressed"):
+        raise ValueError(
+            f"LEAPQUANT_STATE must be 'mirror' or 'compressed', got {mode!r}"
+        )
+    return mode
+
+
+def leapquant_compressed_only() -> bool:
+    """True when the fp32 state per slot is replaced by the LeapQuant state (phase 2)."""
+    return leapquant_enabled() and leapquant_state_mode() == "compressed"
+
+
+def leapquant_fast() -> bool:
+    return os.environ.get("LEAPQUANT_FAST", "1").strip() != "0"
+
+
+def leapquant_bytes_per_head(
+    key_channels: int, value_channels: int, window_length: int,
+    compensators: int = LEAPQUANT_COMPENSATORS,
+) -> int:
+    """Boundary state (int8 matrix, two fp32 scale vectors, fp16 compensators) plus the
+    window of fp16 records: 19,456 + 8,224 bytes for a 128 x 128 head and a window of 16."""
+    boundary = (
+        value_channels * key_channels
+        + 4 * (value_channels + key_channels)
+        + 2 * compensators * (key_channels + value_channels)
+    )
+    window = 2 * window_length * (key_channels + value_channels) + 2 * window_length
+    return boundary + window
+
+
+def leapquant_temporal_rows(size: int) -> int:
+    """Rows of ``temporal``: one per slot plus padding, or two in the compressed state."""
+    return 2 if leapquant_compressed_only() else size + 1
+
+
+def leapquant_ring_slots(slots: int) -> int:
+    """The ReplaySSM decode ring is not used by LeapQuant: one slot is enough."""
+    return 1 if leapquant_enabled() else slots
+
+
+def _load_engine_module():
+    home = os.environ.get("LEAPQUANT_HOME")
+    if not home:
+        raise RuntimeError(
+            "--enable-linear-leapquant requires LEAPQUANT_HOME: the path of a "
+            "leapquant-core checkout in which `make cuda` has been run."
+        )
+    kernel_dir = os.path.join(home, "kernel")
+    if not os.path.isfile(os.path.join(kernel_dir, "leapquant_engine.py")):
+        raise RuntimeError(f"LEAPQUANT_HOME={home!r} holds no kernel/leapquant_engine.py")
+    if kernel_dir not in sys.path:
+        sys.path.insert(0, kernel_dir)
+    os.environ.setdefault("LEAPQUANT_BUILD_DIR", os.path.join(home, "build"))
+    import leapquant_engine
+
+    return leapquant_engine
+
+
+def leapquant_checkpoint_store_class():
+    """The prefix-cache checkpoint store in the LeapQuant boundary format. It
+    has the interface of ``Int8CheckpointStore`` (mamba_checkpoint_pool.py)."""
+    return _load_engine_module().CheckpointStore
+
+
+def build_leapquant_state(state_pool: Any, device: Any, window_length: int) -> Optional[Any]:
+    """The LeapQuant state over ``state_pool``; built once per pool and
+    registered with it. ``state_pool`` is the backend's MambaPool view."""
+    existing = getattr(state_pool, "_leapquant_state", None)
+    if existing is not None:
+        return existing
+
+    compressed = leapquant_compressed_only()
+    temporal = state_pool.mamba_cache.temporal  # [layers, rows, HV, V, K]
+    if temporal.dim() != 5 or temporal.numel() == 0 or not temporal.is_contiguous():
+        raise RuntimeError(
+            "--enable-linear-leapquant expects a contiguous [layers, slots, HV, V, K] "
+            f"SSM state, got shape {tuple(temporal.shape)}"
+        )
+    if temporal.dtype != torch.float32:
+        raise RuntimeError(
+            "--enable-linear-leapquant requires a float32 SSM state "
+            f"(--mamba-ssm-dtype float32), got {temporal.dtype}"
+        )
+    cursor = state_pool.replayssm_write_pos
+    if cursor is None:
+        raise RuntimeError("--enable-linear-leapquant requires --enable-linear-replayssm")
+    if compressed:
+        from sglang.srt.environ import envs
+
+        if envs.SGLANG_ENABLE_GDN_PREFILL_GRAPH_EXTEND.get():
+            raise RuntimeError(
+                "LEAPQUANT_STATE=compressed does not support the GDN prefill CUDA graph "
+                "(SGLANG_ENABLE_GDN_PREFILL_GRAPH_EXTEND): its captured slot indices "
+                "address the fp32 state, which this mode does not keep."
+            )
+
+    layers, rows, value_heads, value_channels, key_channels = temporal.shape
+    slots = state_pool.size + 1 if compressed else rows
+    layer_ids = list(getattr(state_pool, "mamba_layer_ids", range(layers)))
+    compensators = [leapquant_compensators(layer_id) for layer_id in layer_ids]
+    engine_module = _load_engine_module()
+    state = engine_module.EngineState(
+        layers=layers,
+        slots=slots,
+        value_heads=value_heads,
+        key_heads=None,  # read from the packed qkv width at the first decode
+        key_channels=key_channels,
+        value_channels=value_channels,
+        max_rows=slots,
+        window_length=window_length,
+        compensator_count=compensators,
+        device=device,
+        cursor=cursor,
+        padding_slot=_PADDING_SLOT,
+        fast=True if compressed else leapquant_fast(),
+        compressed_only=compressed,
+    )
+    # Unified memory rejects side states here, loudly; that is intended.
+    state_pool.register_slot_state(state)
+    state_pool._leapquant_state = state
+    logger.info(
+        "LeapQuant decode state allocated: %d layers x %d slots x %d heads, "
+        "window %d, compensators %s, %.3f GB, %s kernels, state %s",
+        layers,
+        slots,
+        value_heads,
+        window_length,
+        ",".join(str(count) for count in compensators),
+        state.bytes_allocated() / (1 << 30),
+        "fast" if state.fast else "exact",
+        "compressed only (no fp32 state per slot)" if compressed else "mirrored in fp32 (phase 1)",
+    )
+    return state
