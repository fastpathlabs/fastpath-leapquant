{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqh.request.v1",
  "title": "One request attempt (requests.jsonl line)",
  "type": "object",
  "required": ["request_id", "attempt", "phase", "status", "t_send"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "retry_of": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "parent_id": {"type": ["string", "null"]},
    "worker": {"type": ["integer", "null"], "minimum": 0},
    "phase": {"enum": ["warmup", "measured", "sustained", "probe"]},
    "clock_domain": {"enum": ["run", "request_relative"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens_reported": {"type": ["integer", "null"], "minimum": 0},
    "requested_output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"]},
    "output_tokens_source": {"enum": ["usage_final", "usage_continuous", "chunk_count", "upstream_usage", "upstream_retokenized", "unknown"]},
    "t_scheduled": {"type": ["number", "null"]},
    "t_send": {"type": "number"},
    "t_first_token": {"type": ["number", "null"]},
    "t_last_token": {"type": ["number", "null"]},
    "t_terminal": {"type": ["number", "null"]},
    "t_deadline": {"type": ["number", "null"]},
    "status": {"enum": ["success", "failed", "timeout", "cancelled", "incomplete"]},
    "error": {"type": ["string", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "http_status": {"type": ["integer", "null"]},
    "content_chunks": {"type": ["integer", "null"], "minimum": 0},
    "empty_chunks": {"type": ["integer", "null"], "minimum": 0},
    "exact_chunk_tokens": {"type": ["boolean", "null"]},
    "done_seen": {"type": ["boolean", "null"]}
  }
}
