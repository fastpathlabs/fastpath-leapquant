     "quality_status_required": "qualified",
     "p99_token_gap_metric": "itl_token_ms",
     "p99_token_gap_note": "exact token gaps; when per-chunk token counts are unknown the limit is unmeasurable (chunk gaps are not substituted)"
    },
    "eligibility": "measured requests of the run (warmup excluded); finite cohort over the cohort duration, sustained lane inside the steady window",
    "units": {
     "ttft_ms_max": "ms",
     "tpot_ms_max": "ms per output token",
     "error_rate_max": "fraction of attempted measured requests"
    },
    "scope_note": "TTFT limit stated for 1,000-token prompts; for 8,192-token prompts slo-batch-v1 is reported alongside"
